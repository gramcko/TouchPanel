<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Built-in theme: `oled`. True-black background for OLED panels with near-black surfaces that
        still separate from the panel background, light text, and a cyan accent. It is distinguishable
        from `highContrast` (which uses pure-white borders and a yellow accent). Defines exactly the
        same palette key set as `Theme/Colors.xaml`/`Dark.xaml` (only values differ); `ThemeId` is
        the stable id marker for `ThemeManager`.
    -->
    <sys:String x:Key="ThemeId">oled</sys:String>

    <Color x:Key="PanelBackgroundColor">#FF000000</Color>
    <Color x:Key="PanelForegroundColor">#FFF2F2F2</Color>
    <Color x:Key="PanelDisabledForegroundColor">#FF8A8A8A</Color>
    <Color x:Key="PanelAccentColor">#FF00C2FF</Color>
    <Color x:Key="WidgetSurfaceColor">#FF121212</Color>
    <Color x:Key="WidgetPressedColor">#FF1F1F1F</Color>
    <Color x:Key="WidgetDisabledColor">#FF0D0D0D</Color>
    <Color x:Key="WidgetBorderColor">#FF2E2E2E</Color>
    <Color x:Key="WidgetErrorColor">#FFFF5A5A</Color>

    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}" />
    <SolidColorBrush x:Key="PanelForegroundBrush" Color="{StaticResource PanelForegroundColor}" />
    <SolidColorBrush x:Key="PanelDisabledForegroundBrush" Color="{StaticResource PanelDisabledForegroundColor}" />
    <SolidColorBrush x:Key="PanelAccentBrush" Color="{StaticResource PanelAccentColor}" />
    <SolidColorBrush x:Key="WidgetSurfaceBrush" Color="{StaticResource WidgetSurfaceColor}" />
    <SolidColorBrush x:Key="WidgetPressedBrush" Color="{StaticResource WidgetPressedColor}" />
    <SolidColorBrush x:Key="WidgetDisabledBrush" Color="{StaticResource WidgetDisabledColor}" />
    <SolidColorBrush x:Key="WidgetBorderBrush" Color="{StaticResource WidgetBorderColor}" />
    <SolidColorBrush x:Key="WidgetErrorBrush" Color="{StaticResource WidgetErrorColor}" />

</ResourceDictionary>
