<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        M3-RF-842 built-in theme: `light`. Defines exactly the same palette key set as
        `Theme/Colors.xaml`/`Dark.xaml` (only values differ), so switching themes never requires a
        template to know about a new key. `ThemeId` is the stable id marker for `ThemeManager`.
    -->
    <sys:String x:Key="ThemeId">light</sys:String>

    <Color x:Key="PanelBackgroundColor">#FFF4F5F7</Color>
    <Color x:Key="PanelForegroundColor">#FF1B1B1F</Color>
    <Color x:Key="PanelDisabledForegroundColor">#FF8A8A93</Color>
    <Color x:Key="PanelAccentColor">#FF1D5FE0</Color>
    <Color x:Key="WidgetSurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="WidgetPressedColor">#FFE3E7EF</Color>
    <Color x:Key="WidgetDisabledColor">#FFECEDF1</Color>
    <Color x:Key="WidgetBorderColor">#FFC5CAD3</Color>
    <Color x:Key="WidgetErrorColor">#FFC0392B</Color>

    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}" />
    <SolidColorBrush x:Key="PanelForegroundBrush" Color="{StaticResource PanelForegroundColor}" />
    <SolidColorBrush x:Key="PanelDisabledForegroundBrush" Color="{StaticResource PanelDisabledForegroundColor}" />
    <SolidColorBrush x:Key="PanelAccentBrush" Color="{StaticResource PanelAccentColor}" />
    <SolidColorBrush x:Key="WidgetSurfaceBrush" Color="{StaticResource WidgetSurfaceColor}" />
    <SolidColorBrush x:Key="WidgetPressedBrush" Color="{StaticResource WidgetPressedColor}" />
    <SolidColorBrush x:Key="WidgetDisabledBrush" Color="{StaticResource WidgetDisabledColor}" />
    <SolidColorBrush x:Key="WidgetBorderBrush" Color="{StaticResource WidgetBorderColor}" />
    <SolidColorBrush x:Key="WidgetErrorBrush" Color="{StaticResource WidgetErrorColor}" />

</ResourceDictionary>
