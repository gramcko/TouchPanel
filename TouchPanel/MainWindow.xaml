<Window x:Class="TouchPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TouchPanel.Views"
        Title="TouchPanel"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource PanelBackgroundBrush}">
    <!--
        The borderless, non-activating panel window (RF-014/RF-018/RF-019/RF-028, DD-5).
        Size and position are owned by MainWindow.xaml.cs through SetWindowPos in physical
        pixels, so no Width/Height/WindowStartupLocation are declared here. The config-driven
        widget page (T-10/RF-032) is hosted by WidgetPageHost; the composition root assigns the
        active PageViewModel as the window's DataContext once the configuration has loaded.
    -->
    <Grid x:Name="PanelRoot"
          Stylus.IsPressAndHoldEnabled="False"
          Stylus.IsFlicksEnabled="False">
        <views:WidgetPageHost x:Name="PageHost" />
        <!-- T-16/RF-091: the in-panel page selector sits above the widgets in normal mode; the
             edit overlay below covers it while editing so a switch cannot discard an edit session. -->
        <views:PageSwitcherView x:Name="PageSwitcher" />
        <!-- T-12/RF-039: the edit overlay sits above the page host and collapses outside edit mode. -->
        <views:EditOverlay x:Name="EditOverlay" />
    </Grid>
</Window>
