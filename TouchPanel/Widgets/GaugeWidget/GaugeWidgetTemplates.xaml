<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:TouchPanel.ViewModels">

    <!-- Keeps the shared touch styles resolvable when this dictionary is loaded on its own (tests).
         The palette itself is merged at the application level, so app-level theme keys win. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/TouchPanel;component/Theme/Styles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Gauge track (T-11, DD-13): a minimal theme-default progress track whose fill width is driven
        by the ProgressBar control logic through the standard PART_Track/PART_Indicator parts. No
        animation and no per-instance code-behind; the gauge is display-only and never hit-tested.
        M3-RF-851: the accent base is a DynamicResource fallback on `Tag`, the override layered over.
    -->
    <Style x:Key="TouchGaugeTrackStyle" TargetType="ProgressBar">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{DynamicResource WidgetDisabledBrush}"
                            BorderBrush="{DynamicResource WidgetBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            SnapsToDevicePixels="True">
                        <Grid x:Name="PART_Track" Margin="2">
                            <Rectangle x:Name="PART_Indicator"
                                       HorizontalAlignment="Left"
                                       RadiusX="7"
                                       RadiusY="7"
                                       Tag="{DynamicResource PanelAccentBrush}">
                                <Rectangle.Fill>
                                    <MultiBinding Converter="{StaticResource AppearanceForegroundConverter}">
                                        <Binding Path="AccentBrush" />
                                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                                    </MultiBinding>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Gauge widget template (T-11, RF-033/RF-034/RF-038/RF-065): renders the configured label, the
        view model's formatted value (or the explicit "Unavailable" text in the disabled foreground
        tone, never a fabricated zero), and a fill track mapped onto the configured range. The
        template is pure XAML and updates only when the view model raises notifications, which
        happens at most once per changed snapshot value.
    -->
    <DataTemplate x:Key="Widget.Gauge" DataType="{x:Type vm:GaugeWidgetViewModel}">
        <Border Opacity="{Binding Opacity, TargetNullValue=1.0}"
                BorderBrush="{DynamicResource WidgetBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                SnapsToDevicePixels="True"
                Tag="{DynamicResource WidgetSurfaceBrush}">
            <Border.Background>
                <MultiBinding Converter="{StaticResource AppearanceForegroundConverter}">
                    <Binding Path="BackgroundBrush" />
                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </Border.Background>
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock x:Name="IconGlyph"
                               Text="{Binding IconGlyph}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="{Binding FontSize, TargetNullValue=18}"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasIcon, Converter={StaticResource BoolVisibilityConverter}}" />
                    <TextBlock Text="{Binding Label}"
                               Style="{StaticResource PanelTextStyle}"
                               Tag="{DynamicResource PanelForegroundBrush}"
                               FontSize="{Binding FontSize, TargetNullValue=18}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource AppearanceForegroundConverter}">
                                <Binding Path="ForegroundBrush" />
                                <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>

                <TextBlock x:Name="GaugeValue"
                           Grid.Row="1"
                           Text="{Binding ValueText}"
                           FontSize="40"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PanelForegroundBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextOptions.TextFormattingMode="Display" />

                <ProgressBar Grid.Row="2"
                             Height="18"
                             Style="{StaticResource TouchGaugeTrackStyle}"
                             Value="{Binding Progress, Mode=OneWay}" />
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                <Setter TargetName="GaugeValue" Property="Foreground" Value="{DynamicResource PanelDisabledForegroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter TargetName="GaugeValue" Property="Foreground" Value="{DynamicResource PanelDisabledForegroundBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
