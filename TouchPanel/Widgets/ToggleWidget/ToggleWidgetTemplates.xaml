<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:TouchPanel.Views.Controls"
                    xmlns:vm="clr-namespace:TouchPanel.ViewModels">

    <!-- Keeps the shared touch styles resolvable when this dictionary is loaded on its own (tests).
         The palette itself is merged at the application level, so app-level theme keys win. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/TouchPanel;component/Theme/Styles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Toggle widget template (T-10, DD-6). Each completed tap flips the runtime on/off state once
        and executes the bound action once (RF-035); the on-state is rendered by the
        TouchToggleButtonStyle trigger on the view model's IsOn (D-15: runtime-only, never
        persisted). Failures raise the transient error badge (RF-036). No code-behind. M3-RF-851:
        the surface base is a DynamicResource fallback carried on `Tag` and the per-widget override
        is layered through the shared converter so it still wins.
    -->
    <DataTemplate x:Key="Widget.Toggle" DataType="{x:Type vm:ToggleWidgetViewModel}">
        <Grid ToolTip="{Binding DisabledReason}"
              Opacity="{Binding Opacity, TargetNullValue=1.0}"
              ToolTipService.ShowOnDisabled="True"
              ToolTipService.InitialShowDelay="400"
              ToolTipService.ShowDuration="8000">
            <Button Style="{StaticResource TouchToggleButtonStyle}"
                    Tag="{DynamicResource WidgetSurfaceBrush}"
                    Command="{Binding ActivateCommand}"
                    IsEnabled="{Binding IsEnabled}">
                <Button.Background>
                    <MultiBinding Converter="{StaticResource AppearanceForegroundConverter}">
                        <Binding Path="BackgroundBrush" />
                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                    </MultiBinding>
                </Button.Background>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <controls:WidgetIconPresenter x:Name="IconGlyph"
                                                  Glyph="{Binding DisplayIconGlyph}"
                                                  PathData="{Binding DisplayIconPathData}"
                                                  Stroke="{Binding DisplayIconStroke}"
                                                  StrokeUnits="{Binding DisplayIconStrokeUnits}"
                                                  IconSize="{Binding FontSize, TargetNullValue=20}"
                                                  Margin="0,0,6,0"
                                                  VerticalAlignment="Center"
                                                  Visibility="{Binding HasDisplayIcon, Converter={StaticResource BoolVisibilityConverter}}">
                        <!--
                            User-requested on-state icon: the presenter shows the base icon until
                            the toggle is on with a distinct on icon configured. The active surface
                            is accent-filled, so the on icon defaults to PanelBackgroundBrush (a
                            contrasting theme colour in every theme) instead of the accent; the
                            per-widget on-icon colour override wins when configured. Off state keeps
                            PanelForegroundBrush.
                        -->
                        <controls:WidgetIconPresenter.Style>
                            <Style TargetType="{x:Type controls:WidgetIconPresenter}">
                                <Setter Property="Tag" Value="{DynamicResource PanelForegroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UsesOnIcon}" Value="True">
                                        <Setter Property="Tag" Value="{DynamicResource PanelBackgroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:WidgetIconPresenter.Style>
                        <controls:WidgetIconPresenter.Foreground>
                            <MultiBinding Converter="{StaticResource AppearanceForegroundConverter}">
                                <Binding Path="DisplayIconBrush" />
                                <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                            </MultiBinding>
                        </controls:WidgetIconPresenter.Foreground>
                    </controls:WidgetIconPresenter>
                    <TextBlock x:Name="ToggleLabel"
                               Text="{Binding Label}"
                               FontSize="{Binding FontSize, TargetNullValue=20}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Border x:Name="ErrorBadge"
                    Style="{StaticResource WidgetErrorBadgeStyle}"
                    Visibility="Collapsed">
                <TextBlock Text="!"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <!-- RF-047/RF-079: always-visible disabled indicator; the tooltip keeps the reason. -->
            <Border x:Name="DisabledBadge"
                    Style="{StaticResource WidgetDisabledBadgeStyle}"
                    ToolTip="{Binding DisabledReason}"
                    Visibility="Collapsed">
                <TextBlock Text="&#x2298;"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PanelBackgroundBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasError}" Value="True">
                <Setter TargetName="ErrorBadge" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ShowsDisabledIndicator}" Value="True">
                <Setter TargetName="DisabledBadge" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
