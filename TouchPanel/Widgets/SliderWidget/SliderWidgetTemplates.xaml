<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:TouchPanel.ViewModels"
                    xmlns:widgets="clr-namespace:TouchPanel.Widgets">

    <!-- Keeps the shared touch styles resolvable when this dictionary is loaded on its own (tests).
         The palette itself is merged at the application level, so app-level theme keys win. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/TouchPanel;component/Theme/Styles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Slider widget template (T-06, RF-040/M2-RF-401..406). The touch-first track is supplied by
        TouchSliderStyle (Theme/Styles.xaml); the two-way Value binding updates the view model while
        dragging (throttled emission), and InteractionCompletedCommand emits the final value once
        per completed gesture. Failures raise the shared transient error badge (RF-036); invalid
        bindings raise the persistent disabled badge (RF-047). No code-behind. M3-RF-851: the
        background base is a DynamicResource fallback on `Tag`, the override layered over it.
    -->
    <DataTemplate x:Key="Widget.Slider" DataType="{x:Type vm:SliderWidgetViewModel}">
        <Grid ToolTip="{Binding DisabledReason}"
              Opacity="{Binding Opacity, TargetNullValue=1.0}"
              ToolTipService.ShowOnDisabled="True"
              ToolTipService.InitialShowDelay="400"
              ToolTipService.ShowDuration="8000">
            <Border BorderBrush="{DynamicResource WidgetBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    SnapsToDevicePixels="True"
                    Tag="{DynamicResource WidgetSurfaceBrush}">
                <Border.Background>
                    <MultiBinding Converter="{StaticResource AppearanceForegroundConverter}">
                        <Binding Path="BackgroundBrush" />
                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                    </MultiBinding>
                </Border.Background>
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock x:Name="IconGlyph"
                                   Text="{Binding IconGlyph}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="{Binding FontSize, TargetNullValue=16}"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasIcon, Converter={StaticResource BoolVisibilityConverter}}" />
                        <TextBlock Text="{Binding Label}"
                                   Style="{StaticResource PanelTextStyle}"
                                   Tag="{DynamicResource PanelForegroundBrush}"
                                   FontSize="{Binding FontSize, TargetNullValue=16}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <MultiBinding Converter="{StaticResource AppearanceForegroundConverter}">
                                    <Binding Path="ForegroundBrush" />
                                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                                </MultiBinding>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>

                    <widgets:TouchSlider Grid.Row="1"
                                         Margin="0,6"
                                         Style="{StaticResource TouchSliderStyle}"
                                         Orientation="{Binding Orientation}"
                                         Minimum="{Binding Minimum}"
                                         Maximum="{Binding Maximum}"
                                         TickFrequency="{Binding Step}"
                                         SmallChange="{Binding Step}"
                                         LargeChange="{Binding Step}"
                                         IsSnapToTickEnabled="True"
                                         Value="{Binding Value, Mode=TwoWay}"
                                         InteractionCompletedCommand="{Binding CompleteInteractionCommand}"
                                         IsEnabled="{Binding IsEnabled}" />

                    <TextBlock Grid.Row="2"
                               Text="{Binding ValueText}"
                               Style="{StaticResource PanelTextStyle}"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                </Grid>
            </Border>

            <Border x:Name="ErrorBadge"
                    Style="{StaticResource WidgetErrorBadgeStyle}"
                    Visibility="Collapsed">
                <TextBlock Text="!"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <!-- RF-047/RF-079: always-visible disabled indicator; the tooltip keeps the reason. -->
            <Border x:Name="DisabledBadge"
                    Style="{StaticResource WidgetDisabledBadgeStyle}"
                    ToolTip="{Binding DisabledReason}"
                    Visibility="Collapsed">
                <TextBlock Text="&#x2298;"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PanelBackgroundBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasError}" Value="True">
                <Setter TargetName="ErrorBadge" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ShowsDisabledIndicator}" Value="True">
                <Setter TargetName="DisabledBadge" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
