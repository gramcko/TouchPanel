<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:TouchPanel.ViewModels">

    <!-- Keeps the shared touch styles resolvable when this dictionary is loaded on its own (tests).
         The palette itself is merged at the application level, so app-level theme keys win. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/TouchPanel;component/Theme/Styles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Unsupported widget placeholder (T-10, RF-047/RF-079): rendered disabled with the error
        badge instead of being dropped, so an unknown widget type stays visible and diagnosable.
        No code-behind.
    -->
    <DataTemplate x:Key="Widget.Unsupported" DataType="{x:Type vm:UnsupportedWidgetViewModel}">
        <Grid>
            <Border Background="{DynamicResource WidgetDisabledBrush}"
                    BorderBrush="{DynamicResource WidgetErrorBrush}"
                    BorderThickness="2"
                    CornerRadius="8">
                <StackPanel Margin="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayLabel}"
                               Foreground="{DynamicResource PanelDisabledForegroundBrush}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding UnsupportedReason}"
                               Foreground="{DynamicResource PanelDisabledForegroundBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource WidgetErrorBadgeStyle}">
                <TextBlock Text="!"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
