<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:TouchPanel.ViewModels">

    <!-- Keeps the shared touch styles resolvable when this dictionary is loaded on its own (tests).
         The palette itself is merged at the application level, so app-level theme keys win. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/TouchPanel;component/Theme/Styles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Clock widget template (RF-046/M3-RF-462/463, DD-M3-6). Display-only: it renders the pinned
        view model's DisplayText and updates only when that text changes. No hit testing and no
        per-instance logic. M3-RF-851: the surface/foreground bases are DynamicResource fallbacks
        carried on `Tag`, the per-widget overrides layered over via the shared converter.
    -->
    <DataTemplate x:Key="Widget.Clock" DataType="{x:Type vm:ClockWidgetViewModel}">
        <Border Opacity="{Binding Opacity, TargetNullValue=1.0}"
                BorderBrush="{DynamicResource WidgetBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                SnapsToDevicePixels="True"
                IsHitTestVisible="False"
                Tag="{DynamicResource WidgetSurfaceBrush}">
            <Border.Background>
                <MultiBinding Converter="{StaticResource AppearanceForegroundConverter}">
                    <Binding Path="BackgroundBrush" />
                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </Border.Background>
            <StackPanel Margin="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock x:Name="ClockLabel"
                           Text="{Binding Label}"
                           FontSize="{Binding FontSize, TargetNullValue=16}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"
                           Tag="{DynamicResource PanelForegroundBrush}"
                           Visibility="{Binding HasLabel, Converter={StaticResource BoolVisibilityConverter}}">
                    <TextBlock.Foreground>
                        <MultiBinding Converter="{StaticResource AppearanceForegroundConverter}">
                            <Binding Path="ForegroundBrush" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </TextBlock.Foreground>
                </TextBlock>
                <TextBlock x:Name="ClockValue"
                           Text="{Binding DisplayText}"
                           FontSize="34"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           TextOptions.TextFormattingMode="Display"
                           Foreground="{DynamicResource PanelForegroundBrush}" />
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding ShowsDisabledIndicator}" Value="True">
                <Setter TargetName="ClockValue" Property="Foreground" Value="{DynamicResource PanelDisabledForegroundBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
