<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:TouchPanel.ViewModels">

    <!-- Keeps the shared touch styles resolvable when this dictionary is loaded on its own (tests).
         The palette itself is merged at the application level, so app-level theme keys win. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/TouchPanel;component/Theme/Styles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Label widget template (T-10, DD-6): display-only text driven by the configured label
        (RF-034); it has no action, no command, and no error badge. No code-behind. M3-RF-851: the
        theme foreground is a DynamicResource fallback carried on `Tag` and the per-widget override
        is layered through the shared converter so it still wins.
    -->
    <DataTemplate x:Key="Widget.Label" DataType="{x:Type vm:LabelWidgetViewModel}">
        <Grid IsHitTestVisible="False"
              Opacity="{Binding Opacity, TargetNullValue=1.0}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock x:Name="IconGlyph"
                           Text="{Binding IconGlyph}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="{Binding FontSize, TargetNullValue=22}"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasIcon, Converter={StaticResource BoolVisibilityConverter}}" />
                <TextBlock x:Name="LabelText"
                           Text="{Binding Label}"
                           Style="{StaticResource TouchLabelTextStyle}"
                           Tag="{DynamicResource PanelForegroundBrush}"
                           FontSize="{Binding FontSize, TargetNullValue=22}"
                           VerticalAlignment="Center">
                    <TextBlock.Foreground>
                        <MultiBinding Converter="{StaticResource AppearanceForegroundConverter}">
                            <Binding Path="ForegroundBrush" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </TextBlock.Foreground>
                </TextBlock>
            </StackPanel>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
