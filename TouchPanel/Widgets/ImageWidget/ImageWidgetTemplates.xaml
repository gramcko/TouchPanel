<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:TouchPanel.ViewModels">

    <!-- Keeps the shared touch styles resolvable when this dictionary is loaded on its own (tests).
         The palette itself is merged at the application level, so app-level theme keys win. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/TouchPanel;component/Theme/Styles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Image widget template (user-requested addition). Display-only: it renders the decoded bitmap
        scaled into the widget bounds by the configured Stretch mode. The widget is not hit-tested,
        so taps never reach it (RF-018/RF-025). When no image is available an explicit placeholder is
        shown in the theme's disabled foreground tone (DynamicResource), never a blank or fabricated
        surface. M3-RF-851: the surface/override layering uses the shared converter with the
        DynamicResource base carried on `Tag`.
    -->
    <DataTemplate x:Key="Widget.Image" DataType="{x:Type vm:ImageWidgetViewModel}">
        <Border Opacity="{Binding Opacity, TargetNullValue=1.0}"
                BorderBrush="{DynamicResource WidgetBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                SnapsToDevicePixels="True"
                IsHitTestVisible="False"
                ToolTip="{Binding DisabledReason}"
                ToolTipService.ShowOnDisabled="True"
                Tag="{DynamicResource WidgetSurfaceBrush}">
            <Border.Background>
                <MultiBinding Converter="{StaticResource AppearanceForegroundConverter}">
                    <Binding Path="BackgroundBrush" />
                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </Border.Background>
            <Grid>
                <Image x:Name="ImageContent"
                       Source="{Binding Image}"
                       Stretch="{Binding Stretch}"
                       SnapsToDevicePixels="True"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding HasImage, Converter={StaticResource BoolVisibilityConverter}}" />
                <TextBlock x:Name="ImagePlaceholder"
                           Text="{Binding Placeholder}"
                           Margin="12"
                           FontSize="{Binding FontSize, TargetNullValue=16}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PanelDisabledForegroundBrush}"
                           Visibility="{Binding IsUnavailable, Converter={StaticResource BoolVisibilityConverter}}" />
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
