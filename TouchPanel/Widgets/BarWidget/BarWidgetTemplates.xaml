<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:TouchPanel.Views.Controls"
                    xmlns:vm="clr-namespace:TouchPanel.ViewModels">

    <!-- Keeps the shared touch styles resolvable when this dictionary is loaded on its own (tests).
         The palette itself is merged at the application level, so app-level theme keys win. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/TouchPanel;component/Theme/Styles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Bar track (RF-046/M3-RF-466/467): a horizontal meter whose fill width is driven by the
        standard ProgressBar PART_Track/PART_Indicator parts. No animation and no per-instance code.
        M3-RF-851: the accent base is a DynamicResource fallback on `Tag`, the override layered over.
    -->
    <Style x:Key="TouchBarTrackStyle" TargetType="ProgressBar">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{DynamicResource WidgetDisabledBrush}"
                            BorderBrush="{DynamicResource WidgetBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <Grid x:Name="PART_Track" Margin="2">
                            <Rectangle x:Name="PART_Indicator"
                                       HorizontalAlignment="Left"
                                       RadiusX="4"
                                       RadiusY="4"
                                       Tag="{DynamicResource PanelAccentBrush}">
                                <Rectangle.Fill>
                                    <MultiBinding Converter="{StaticResource AppearanceForegroundConverter}">
                                        <Binding Path="AccentBrush" />
                                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                                    </MultiBinding>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Bar widget template (RF-046/M3-RF-466/467, DD-M3-6): a single-value horizontal meter that
        renders the configured label, the numeric value (when showValue), and the value mapped onto
        the configured range. "Unavailable" is shown explicitly (in the disabled foreground tone)
        instead of a fabricated zero; the template updates only when the view model notifies.
    -->
    <DataTemplate x:Key="Widget.Bar" DataType="{x:Type vm:BarWidgetViewModel}">
        <Border Opacity="{Binding Opacity, TargetNullValue=1.0}"
                BorderBrush="{DynamicResource WidgetBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                SnapsToDevicePixels="True"
                ToolTip="{Binding DisabledReason}"
                ToolTipService.ShowOnDisabled="True"
                Tag="{DynamicResource WidgetSurfaceBrush}">
            <Border.Background>
                <MultiBinding Converter="{StaticResource AppearanceForegroundConverter}">
                    <Binding Path="BackgroundBrush" />
                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </Border.Background>
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                    <!--
                        User-requested addition: an optional label icon renders in place of the
                        label text (same colour/size), with the text kept as the tooltip. The label
                        text stays visible by default, so older configurations are unchanged.
                    -->
                    <controls:WidgetIconPresenter x:Name="BarLabelIcon"
                                                  DockPanel.Dock="Left"
                                                  Glyph="{Binding LabelIconGlyph}"
                                                  PathData="{Binding LabelIconPathData}"
                                                  IconSize="{Binding FontSize, TargetNullValue=18}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="{Binding Label}"
                                                  Tag="{DynamicResource PanelForegroundBrush}"
                                                  Visibility="{Binding HasLabelIcon, Converter={StaticResource BoolVisibilityConverter}}">
                        <controls:WidgetIconPresenter.Foreground>
                            <MultiBinding Converter="{StaticResource AppearanceForegroundConverter}">
                                <Binding Path="ForegroundBrush" />
                                <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                            </MultiBinding>
                        </controls:WidgetIconPresenter.Foreground>
                    </controls:WidgetIconPresenter>
                    <TextBlock x:Name="BarLabel"
                               DockPanel.Dock="Left"
                               Text="{Binding Label}"
                               FontSize="{Binding FontSize, TargetNullValue=18}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Tag="{DynamicResource PanelForegroundBrush}">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource AppearanceForegroundConverter}">
                                <Binding Path="ForegroundBrush" />
                                <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock x:Name="BarValue"
                               DockPanel.Dock="Right"
                               Text="{Binding ValueText}"
                               FontSize="18"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PanelForegroundBrush}"
                               Visibility="{Binding ShowValue, Converter={StaticResource BoolVisibilityConverter}}" />
                </DockPanel>

                <ProgressBar Grid.Row="1"
                             Height="18"
                             Style="{StaticResource TouchBarTrackStyle}"
                             Value="{Binding Progress, Mode=OneWay}" />
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <!-- User-requested addition: the icon replaces the label text while it is set. -->
            <DataTrigger Binding="{Binding HasLabelIcon}" Value="True">
                <Setter TargetName="BarLabel" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                <Setter TargetName="BarValue" Property="Foreground" Value="{DynamicResource PanelDisabledForegroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter TargetName="BarValue" Property="Foreground" Value="{DynamicResource PanelDisabledForegroundBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
