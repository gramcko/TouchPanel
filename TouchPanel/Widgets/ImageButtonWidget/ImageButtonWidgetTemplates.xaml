<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:TouchPanel.Views.Controls"
                    xmlns:vm="clr-namespace:TouchPanel.ViewModels">

    <!-- Keeps the shared touch styles resolvable when this dictionary is loaded on its own (tests).
         The palette itself is merged at the application level, so app-level theme keys win. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/TouchPanel;component/Theme/Styles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        ImageButton widget template (RF-046/M3-RF-464/465, DD-M3-6). A touch-first button showing a
        prominent built-in icon (or the label, or a neutral default when neither is configured) and
        executing exactly one bound action per completed tap (WPF fires Click on release inside the
        control). The shared touch style is Focusable="False", so the tap never takes focus from
        another application (RF-018/RF-025). No code-behind; no external image files.
        M3-RF-851: the surface base is a DynamicResource fallback on `Tag`, the override layered over.
    -->
    <DataTemplate x:Key="Widget.ImageButton" DataType="{x:Type vm:ImageButtonWidgetViewModel}">
        <Grid ToolTip="{Binding DisabledReason}"
              Opacity="{Binding Opacity, TargetNullValue=1.0}"
              ToolTipService.ShowOnDisabled="True"
              ToolTipService.InitialShowDelay="400"
              ToolTipService.ShowDuration="8000">
            <Button Style="{StaticResource TouchButtonStyle}"
                    Tag="{DynamicResource WidgetSurfaceBrush}"
                    Command="{Binding ActivateCommand}"
                    IsEnabled="{Binding IsEnabled}">
                <Button.Background>
                    <MultiBinding Converter="{StaticResource AppearanceForegroundConverter}">
                        <Binding Path="BackgroundBrush" />
                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                    </MultiBinding>
                </Button.Background>
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <controls:WidgetIconPresenter x:Name="IconGlyph"
                                                  Glyph="{Binding DisplayGlyph}"
                                                  PathData="{Binding DisplayPathData}"
                                                  IconSize="{Binding FontSize, TargetNullValue=40}"
                                                  Tag="{DynamicResource PanelForegroundBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Visibility="{Binding ShowIcon, Converter={StaticResource BoolVisibilityConverter}}">
                        <controls:WidgetIconPresenter.Foreground>
                            <MultiBinding Converter="{StaticResource AppearanceForegroundConverter}">
                                <Binding Path="ForegroundBrush" />
                                <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                            </MultiBinding>
                        </controls:WidgetIconPresenter.Foreground>
                    </controls:WidgetIconPresenter>
                    <TextBlock x:Name="ButtonLabel"
                               Text="{Binding Label}"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"
                               Visibility="{Binding ShowLabelText, Converter={StaticResource BoolVisibilityConverter}}" />
                </StackPanel>
            </Button>
            <Border x:Name="ErrorBadge"
                    Style="{StaticResource WidgetErrorBadgeStyle}"
                    Visibility="Collapsed">
                <TextBlock Text="!"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <!-- RF-047/RF-079: always-visible disabled indicator; the tooltip keeps the reason. -->
            <Border x:Name="DisabledBadge"
                    Style="{StaticResource WidgetDisabledBadgeStyle}"
                    ToolTip="{Binding DisabledReason}"
                    Visibility="Collapsed">
                <TextBlock Text="&#x2298;"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PanelBackgroundBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasError}" Value="True">
                <Setter TargetName="ErrorBadge" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ShowsDisabledIndicator}" Value="True">
                <Setter TargetName="DisabledBadge" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
