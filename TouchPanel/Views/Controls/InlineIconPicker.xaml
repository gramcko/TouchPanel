<UserControl x:Class="TouchPanel.Views.Controls.InlineIconPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TouchPanel.Views.Controls"
             Focusable="False"
             Stylus.IsPressAndHoldEnabled="False"
             Stylus.IsFlicksEnabled="False">

    <!--
        Touch-sized field button for the long icon catalogs (user-requested flyout replacement). The
        40 DIP header shows the current entry; a tap asks the owning editor to open the docked icon
        flyout to the left of the property panel. Nothing expands inside the panel any more, so
        opening a picker never pushes the remaining fields down.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TouchPanel;component/Theme/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Collapsed header: themed like the surrounding fields, >= 40 DIP, tap toggles. -->
            <Style x:Key="InlinePickerHeaderStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{DynamicResource PanelForegroundBrush}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="HeaderSurface"
                                    Background="{DynamicResource WidgetSurfaceBrush}"
                                    BorderBrush="{DynamicResource WidgetBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource WidgetPressedBrush}" />
                                    <Setter TargetName="HeaderSurface" Property="BorderBrush" Value="{DynamicResource PanelAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Button x:Name="PickerHeader"
            Style="{StaticResource InlinePickerHeaderStyle}"
            Click="OnHeaderClick"
            AutomationProperties.Name="Choose icon">
        <DockPanel LastChildFill="True">
            <local:WidgetIconPresenter DockPanel.Dock="Left"
                                       Glyph="{Binding SelectedItem.Glyph, RelativeSource={RelativeSource AncestorType={x:Type local:InlineIconPicker}}}"
                                       PathData="{Binding SelectedItem.PathData, RelativeSource={RelativeSource AncestorType={x:Type local:InlineIconPicker}}}"
                                       Stroke="{Binding SelectedItem.Stroke, RelativeSource={RelativeSource AncestorType={x:Type local:InlineIconPicker}}}"
                                       StrokeUnits="{Binding SelectedItem.StrokeUnits, RelativeSource={RelativeSource AncestorType={x:Type local:InlineIconPicker}}}"
                                       IconSize="16"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center">
                <local:WidgetIconPresenter.Style>
                    <Style TargetType="{x:Type local:WidgetIconPresenter}">
                        <Style.Triggers>
                            <DataTrigger Value="">
                                <DataTrigger.Binding>
                                    <Binding Path="SelectedItem.Id"
                                             RelativeSource="{RelativeSource AncestorType={x:Type local:InlineIconPicker}}" />
                                </DataTrigger.Binding>
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </local:WidgetIconPresenter.Style>
            </local:WidgetIconPresenter>
            <TextBlock DockPanel.Dock="Right"
                       Text="&#x25BE;"
                       Margin="8,0,0,0"
                       Opacity="0.7"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource AncestorType={x:Type local:InlineIconPicker}}}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Button>
</UserControl>
