<UserControl x:Class="TouchPanel.Views.Controls.ColorPickerFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TouchPanel.Views.Controls"
             xmlns:controls="clr-namespace:TouchPanel.Views.Controls"
             Focusable="False"
             Stylus.IsPressAndHoldEnabled="False"
             Stylus.IsFlicksEnabled="False">

    <!--
        Shared colour flyout (user-requested picker): the MRU-first swatch grid, the optional "None"
        entry, and the exact-hex field. Used by the pages editor's page-background field; the widget
        property panel embeds the same visual language in PropertyFlyout. No Popup: a drag over the
        grid scrolls through the existing TouchPan behavior.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TouchPanel;component/Theme/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="ColorFlyoutVisibilityConverter" />
            <local:ColorSwatchSelectedConverter x:Key="ColorFlyoutSelectedConverter" />

            <Style x:Key="ColorFlyoutSwatchStyle" TargetType="Button">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Margin" Value="2" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource PanelForegroundBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Background" Value="{DynamicResource WidgetSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WidgetBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TileSurface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="TileSurface" Property="BorderBrush" Value="{DynamicResource PanelAccentBrush}" />
                                    <Setter TargetName="TileSurface" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Value="True">
                        <DataTrigger.Binding>
                            <MultiBinding Converter="{StaticResource ColorFlyoutSelectedConverter}">
                                <Binding />
                                <Binding Path="DataContext.SelectedHex"
                                         RelativeSource="{RelativeSource AncestorType={x:Type local:ColorPickerFlyout}}" />
                                <Binding Path="DataContext.IsInherited"
                                         RelativeSource="{RelativeSource AncestorType={x:Type local:ColorPickerFlyout}}" />
                            </MultiBinding>
                        </DataTrigger.Binding>
                        <Setter Property="BorderBrush" Value="{DynamicResource PanelAccentBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="FlyoutSurface"
            Background="#CC1E1E1E"
            BorderBrush="{DynamicResource WidgetBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="{Binding IsOpen, Converter={StaticResource ColorFlyoutVisibilityConverter}, FallbackValue=Collapsed}">
        <Grid Focusable="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="12,10,10,6" Focusable="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}"
                           FontSize="17"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PanelForegroundBrush}" />
                <Button Grid.Column="1"
                        Width="40"
                        Height="40"
                        MinWidth="40"
                        MinHeight="40"
                        Content="&#x2715;"
                        FontSize="16"
                        Foreground="{DynamicResource PanelForegroundBrush}"
                        Background="{DynamicResource WidgetSurfaceBrush}"
                        BorderBrush="{DynamicResource WidgetBorderBrush}"
                        BorderThickness="1"
                        Command="{Binding CloseCommand}"
                        AutomationProperties.Name="Close colour picker" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="8,0,8,8"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          controls:TouchPan.IsEnabled="True"
                          Focusable="False">
                <StackPanel Focusable="False">
                    <ItemsControl x:Name="FlyoutColorTiles"
                                  ItemsSource="{Binding ColorTiles}"
                                  Focusable="False"
                                  HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ColorFlyoutSwatchStyle}"
                                        Background="{Binding Brush}"
                                        Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ColorPickerFlyout}}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding Name}"
                                        AutomationProperties.Name="{Binding Name}">
                                    <TextBlock Text="{Binding DisplayText}"
                                               Foreground="{DynamicResource PanelForegroundBrush}"
                                               FontSize="11"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBox x:Name="FlyoutHexBox"
                             Height="40"
                             Margin="2,8,2,0"
                             FontSize="15"
                             Padding="8,4"
                             VerticalContentAlignment="Center"
                             Foreground="{DynamicResource PanelForegroundBrush}"
                             Background="{DynamicResource WidgetSurfaceBrush}"
                             BorderBrush="{DynamicResource WidgetBorderBrush}"
                             BorderThickness="1"
                             CaretBrush="{DynamicResource PanelForegroundBrush}"
                             PreviewTextInput="OnHexPreviewTextInput"
                             PreviewKeyDown="OnHexPreviewKeyDown"
                             LostKeyboardFocus="OnHexLostKeyboardFocus"
                             AutomationProperties.Name="Colour hex value"
                             ToolTip="Type #RRGGBB and press Enter" />

                    <TextBlock Margin="2,4,2,0"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="#FFFF6B6B"
                               Text="{Binding HexError}"
                               Visibility="{Binding HasHexError, Converter={StaticResource ColorFlyoutVisibilityConverter}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
