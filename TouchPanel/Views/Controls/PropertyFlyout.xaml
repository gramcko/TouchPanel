<UserControl x:Class="TouchPanel.Views.Controls.PropertyFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TouchPanel.Views.Controls"
             xmlns:controls="clr-namespace:TouchPanel.Views.Controls"
             Focusable="False"
             Stylus.IsPressAndHoldEnabled="False"
             Stylus.IsFlicksEnabled="False">

    <!--
        Docked picker flyout for the property panel (user-requested replacement for inline
        expansion). One surface renders either the icon grid or the colour grid; the editor opens it
        in the slot to the left of the property panel, so the panel never changes height. Everything
        is touch-sized, themed, and scrolls vertically through the existing TouchPan behavior.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TouchPanel;component/Theme/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="FlyoutVisibilityConverter" />
            <local:IconOptionSelectedConverter x:Key="FlyoutIconSelectedConverter" />
            <local:ColorSwatchSelectedConverter x:Key="FlyoutColorSelectedConverter" />

            <Style x:Key="FlyoutTileStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Margin" Value="2" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource PanelForegroundBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Background" Value="{DynamicResource WidgetSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WidgetBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TileSurface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="TileSurface" Property="Background" Value="{DynamicResource WidgetPressedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Value="True">
                        <DataTrigger.Binding>
                            <MultiBinding Converter="{StaticResource FlyoutIconSelectedConverter}">
                                <Binding />
                                <Binding Path="DataContext.SelectedIcon"
                                         RelativeSource="{RelativeSource AncestorType={x:Type local:PropertyFlyout}}" />
                            </MultiBinding>
                        </DataTrigger.Binding>
                        <Setter Property="Background" Value="{DynamicResource WidgetPressedBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource PanelAccentBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="FlyoutSwatchStyle" TargetType="Button">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Margin" Value="2" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource PanelForegroundBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Background" Value="{DynamicResource WidgetSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WidgetBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TileSurface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="TileSurface" Property="BorderBrush" Value="{DynamicResource PanelAccentBrush}" />
                                    <Setter TargetName="TileSurface" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Value="True">
                        <DataTrigger.Binding>
                            <MultiBinding Converter="{StaticResource FlyoutColorSelectedConverter}">
                                <Binding />
                                <Binding Path="DataContext.SelectedHex"
                                         RelativeSource="{RelativeSource AncestorType={x:Type local:PropertyFlyout}}" />
                                <Binding Path="DataContext.IsInherited"
                                         RelativeSource="{RelativeSource AncestorType={x:Type local:PropertyFlyout}}" />
                            </MultiBinding>
                        </DataTrigger.Binding>
                        <Setter Property="BorderBrush" Value="{DynamicResource PanelAccentBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="FlyoutSurface"
            Background="#CC1E1E1E"
            BorderBrush="{DynamicResource WidgetBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="{Binding IsOpen, Converter={StaticResource FlyoutVisibilityConverter}, FallbackValue=Collapsed}">
        <Grid Focusable="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="12,10,10,6" Focusable="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FlyoutTitle"
                           Text="{Binding Title}"
                           FontSize="17"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PanelForegroundBrush}" />
                <Button x:Name="FlyoutCloseButton"
                        Grid.Column="1"
                        Width="40"
                        Height="40"
                        MinWidth="40"
                        MinHeight="40"
                        Content="&#x2715;"
                        FontSize="16"
                        Foreground="{DynamicResource PanelForegroundBrush}"
                        Background="{DynamicResource WidgetSurfaceBrush}"
                        BorderBrush="{DynamicResource WidgetBorderBrush}"
                        BorderThickness="1"
                        Command="{Binding CloseCommand}"
                        AutomationProperties.Name="Close picker" />
            </Grid>

            <!-- Icon grid: every catalog entry (glyph, filled vector, and stroked line art). -->
            <ScrollViewer x:Name="IconScroll"
                          Grid.Row="1"
                          Margin="8,0,8,8"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          controls:TouchPan.IsEnabled="True"
                          Focusable="False"
                          Visibility="{Binding IsIconFlyout, Converter={StaticResource FlyoutVisibilityConverter}}">
                <ItemsControl x:Name="FlyoutIconTiles"
                              ItemsSource="{Binding IconOptions}"
                              Focusable="False"
                              HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource FlyoutTileStyle}"
                                    Width="108"
                                    Height="52"
                                    Command="{Binding DataContext.SelectIconCommand, RelativeSource={RelativeSource AncestorType={x:Type local:PropertyFlyout}}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding DisplayName}"
                                    AutomationProperties.Name="{Binding DisplayName}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <local:WidgetIconPresenter Glyph="{Binding Glyph}"
                                                               PathData="{Binding PathData}"
                                                               Stroke="{Binding Stroke}"
                                                               StrokeUnits="{Binding StrokeUnits}"
                                                               IconSize="16"
                                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayName}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Colour grid: MRU first, then the remaining palette, with an optional "None". -->
            <ScrollViewer x:Name="ColorScroll"
                          Grid.Row="1"
                          Margin="8,0,8,8"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          controls:TouchPan.IsEnabled="True"
                          Focusable="False"
                          Visibility="{Binding IsColorFlyout, Converter={StaticResource FlyoutVisibilityConverter}}">
                <StackPanel Focusable="False">
                    <ItemsControl x:Name="FlyoutColorTiles"
                                  ItemsSource="{Binding ColorTiles}"
                                  Focusable="False"
                                  HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource FlyoutSwatchStyle}"
                                        Background="{Binding Brush}"
                                        Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType={x:Type local:PropertyFlyout}}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding Name}"
                                        AutomationProperties.Name="{Binding Name}">
                                    <TextBlock Text="{Binding DisplayText}"
                                               Foreground="{DynamicResource PanelForegroundBrush}"
                                               FontSize="11"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBox x:Name="FlyoutHexBox"
                             Height="40"
                             Margin="2,8,2,0"
                             FontSize="15"
                             Padding="8,4"
                             VerticalContentAlignment="Center"
                             Foreground="{DynamicResource PanelForegroundBrush}"
                             Background="{DynamicResource WidgetSurfaceBrush}"
                             BorderBrush="{DynamicResource WidgetBorderBrush}"
                             BorderThickness="1"
                             CaretBrush="{DynamicResource PanelForegroundBrush}"
                             PreviewTextInput="OnHexPreviewTextInput"
                             PreviewKeyDown="OnHexPreviewKeyDown"
                             LostKeyboardFocus="OnHexLostKeyboardFocus"
                             AutomationProperties.Name="Colour hex value"
                             ToolTip="Type #RRGGBB and press Enter" />

                    <TextBlock x:Name="FlyoutHexError"
                               Margin="2,4,2,0"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="#FFFF6B6B"
                               Text="{Binding HexError}"
                               Visibility="{Binding HasHexError, Converter={StaticResource FlyoutVisibilityConverter}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
