<UserControl x:Class="TouchPanel.Views.Controls.InlineColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TouchPanel.Views.Controls"
             Focusable="False"
             Stylus.IsPressAndHoldEnabled="False"
             Stylus.IsFlicksEnabled="False">

    <!--
        Touch-sized colour field button (user-requested docked flyout). The 40 DIP header shows the
        current swatch and value (or "Inherited"/"None"); a tap asks the owning editor to open the
        shared colour flyout. The swatch grid and hex entry live in that flyout, never inside the
        property panel, so opening a picker never pushes the remaining fields down.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TouchPanel;component/Theme/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ColorPickerHeaderStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{DynamicResource PanelForegroundBrush}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="HeaderSurface"
                                    Background="{DynamicResource WidgetSurfaceBrush}"
                                    BorderBrush="{DynamicResource WidgetBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource WidgetPressedBrush}" />
                                    <Setter TargetName="HeaderSurface" Property="BorderBrush" Value="{DynamicResource PanelAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Button x:Name="PickerHeader"
            Style="{StaticResource ColorPickerHeaderStyle}"
            Click="OnHeaderClick"
            AutomationProperties.Name="Choose colour">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="CurrentSwatch"
                    Width="24"
                    Height="24"
                    Margin="0,0,8,0"
                    CornerRadius="4"
                    BorderBrush="{DynamicResource WidgetBorderBrush}"
                    BorderThickness="1"
                    SnapsToDevicePixels="True"
                    VerticalAlignment="Center" />

            <TextBlock x:Name="HeaderLabel"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Column="2"
                       Text="&#x25BE;"
                       Margin="8,0,0,0"
                       Opacity="0.7"
                       VerticalAlignment="Center" />
        </Grid>
    </Button>
</UserControl>
