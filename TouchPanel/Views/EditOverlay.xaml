<UserControl x:Class="TouchPanel.Views.EditOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settingsViews="clr-namespace:TouchPanel.Views.Settings"
             Focusable="False"
             IsTabStop="False"
             Stylus.IsPressAndHoldEnabled="False"
             Stylus.IsFlicksEnabled="False">

    <!--
        Edit-mode overlay (T-12, RF-039, DD-7): renders one drag surface plus one resize handle per
        widget above the page host. The ItemsControl reuses the same Canvas geometry bindings as the
        widget host, so drag/resize updates flow through the widget view models; the WPF Thumb
        semantics cover touch (promoted to mouse by WPF) and mouse with one code path. The overlay
        is bound to the EditModeService (DataContext) and collapses whenever edit mode is off, so
        normal-mode interaction is untouched. Code-behind contains only the Thumb wiring.
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Self-contained: the palette and the widget container style resolve without App resources. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TouchPanel;component/Theme/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="EditModeVisibilityConverter" />

            <!-- Selection frame: neutral while unselected, accent while selected (RF-027 feedback). -->
            <Style x:Key="EditSelectionFrameStyle" TargetType="Border">
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="BorderBrush" Value="{DynamicResource WidgetBorderBrush}" />
                <Setter Property="Background" Value="#22000000" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource PanelAccentBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Move surface: the whole widget area; a transparent fill keeps it hit-testable. -->
            <Style x:Key="EditMoveThumbStyle" TargetType="Thumb">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="SizeAll" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                Resize handle (UX fix: discoverability): a 40 DIP corner target usable by touch and
                mouse. The NWSE cursor and the "Drag to resize" tooltip name the affordance; the
                use site gates it to the selected, editable widget so the resize handle, the Edit
                button, and the delete "X" only appear together for the current selection.
            -->
            <Style x:Key="EditResizeThumbStyle" TargetType="Thumb">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="Margin" Value="0,0,4,4" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="SizeNWSE" />
                <Setter Property="ToolTip" Value="Drag to resize" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="{DynamicResource PanelAccentBrush}"
                                    CornerRadius="6"
                                    Opacity="0.9" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                T-13 edit toolbar button (RF-043/M2-RF-438): touch-first at >= 44x44 DIP, press
                feedback is immediate and no affordance depends on hover (RF-025). Focusable=false
                keeps the toolbar off the keyboard focus chain.
            -->
            <Style x:Key="EditToolbarButtonStyle" TargetType="ButtonBase">
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Margin" Value="4,0" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Foreground" Value="{DynamicResource PanelForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WidgetBorderBrush}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ButtonBase">
                            <Border x:Name="Surface"
                                    Background="{DynamicResource WidgetSurfaceBrush}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource WidgetPressedBrush}" />
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PanelAccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                T-15 snap toggle (RF-044/M2-RF-441/M2-RF-445): a touch-first on/off affordance for
                grid snapping and alignment. The checked state is shown with the accent border, so
                the setting is visible without hover (RF-025). It reuses the toolbar button visuals.
            -->
            <Style x:Key="EditToolbarToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource EditToolbarButtonStyle}">
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource PanelAccentBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                M5-RF-501/M5-RF-504: touch-first delete "X" shown in the selected widget's top-right
                corner. At least 40x40 DIP, Focusable=false so it never pulls keyboard focus, and it
                sits above the move surface so it is tappable. Visibility is decided per item by the
                selection/editability triggers applied at the use site.
            -->
            <Style x:Key="EditDeleteButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="0,4,4,0" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Content" Value="X" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="DeleteSurface"
                                    Background="#CCD32F2F"
                                    BorderBrush="#FFFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="20"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="DeleteSurface" Property="Background" Value="#FFB71C1C" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                UX fix #1 / M5-RF-504: touch-first per-widget "Edit" button in the selected widget's
                bottom-right area. At least 40x40 DIP and Focusable=false; it sits to the left of the
                resize handle so the X (top-right), the Edit button, and the resize handle never
                overlap. Visibility is decided per item by the selection/editability triggers applied
                at the use site. Pressing it opens that widget's edit menu (property editor).
            -->
            <Style x:Key="EditWidgetButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="Margin" Value="0,0,48,4" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Content" Value="Edit" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="EditSurface"
                                    Background="{DynamicResource PanelAccentBrush}"
                                    BorderBrush="#FFFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Opacity="0.95"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="EditSurface" Property="Opacity" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- T-13 property editor (RF-043/M2-RF-433): touch-first inputs at >= 40 DIP, no
                 hover-only affordance. Text fields commit when focus leaves (so a tap on another
                 field, or on the focusable Apply button, persists the value). -->
            <Style x:Key="EditPropertySectionLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource PanelForegroundBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Margin" Value="0,8,0,2" />
            </Style>

            <Style x:Key="EditPropertyTextBoxStyle" TargetType="TextBox">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Foreground" Value="{DynamicResource PanelForegroundBrush}" />
                <Setter Property="Background" Value="{DynamicResource WidgetSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WidgetBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CaretBrush" Value="{DynamicResource PanelForegroundBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource PanelAccentBrush}" />
            </Style>

            <Style x:Key="EditPropertyCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{DynamicResource PanelForegroundBrush}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="OverlayRoot"
          Background="Transparent"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Visibility="{Binding IsEditMode, Converter={StaticResource EditModeVisibilityConverter}, FallbackValue=Collapsed}">
        <!--
            The toolbar owns its own Auto row at the bottom so its action cluster (Snap / Duplicate /
            Remove / Exit Edit Mode) is always laid out inside the panel width and can never be covered
            by the property panel. The widget and guide layers span both rows so the overlay geometry
            still matches the full-height widget host.
        -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ItemsControl x:Name="WidgetItems"
                      Grid.Row="0"
                      Grid.RowSpan="2"
                      ItemsSource="{Binding Widgets}"
                      ItemContainerStyle="{StaticResource WidgetContainerStyle}"
                      Focusable="False"
                      IsTabStop="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas Background="Transparent" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- The preview press selects the widget on a simple tap or before a drag, so
                         arrow-key nudging has a target without requiring an actual drag. -->
                    <Grid PreviewMouseLeftButtonDown="OnWidgetPressed">
                        <Border Style="{StaticResource EditSelectionFrameStyle}" />
                        <!-- Unknown widget types preserve their raw JSON and cannot persist
                             geometry, so they expose no drag surface or resize handle. -->
                        <Thumb Style="{StaticResource EditMoveThumbStyle}"
                               Visibility="{Binding CanEditGeometry, Converter={StaticResource EditModeVisibilityConverter}}"
                               DragStarted="OnThumbDragStarted"
                               DragDelta="OnMoveDragDelta"
                               DragCompleted="OnThumbDragCompleted" />
                        <!-- The resize handle is shown only for the selected, editable widget
                             (matching the Edit button and the delete X), so the "Drag to resize"
                             affordance is unambiguous. -->
                        <Thumb x:Name="ResizeWidgetThumb"
                               DragStarted="OnThumbDragStarted"
                               DragDelta="OnResizeDragDelta"
                               DragCompleted="OnThumbDragCompleted">
                            <Thumb.Style>
                                <Style TargetType="Thumb" BasedOn="{StaticResource EditResizeThumbStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CanEditGeometry}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Thumb.Style>
                        </Thumb>
                        <!-- UX fix #1: per-widget Edit button (bottom-right, left of the resize
                             handle) opens this widget's edit menu. Selecting a widget alone never
                             opens the editor. Shown only for the selected, editable widget. -->
                        <Button x:Name="EditWidgetButton"
                                Click="OnEditWidgetClick">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource EditWidgetButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CanEditGeometry}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- M5-RF-501/M5-RF-504: the delete "X" is the last child so it renders
                             above the move surface and stays hit-testable. It is shown only for the
                             selected, editable widget and never in normal mode (the whole overlay
                             collapses outside edit mode). -->
                        <Button x:Name="DeleteWidgetButton"
                                Click="OnDeleteWidgetClick">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource EditDeleteButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CanEditGeometry}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                 </DataTemplate>
             </ItemsControl.ItemTemplate>
         </ItemsControl>

        <!--
            T-15 alignment guide layer (RF-044/M2-RF-444): draws the transient guides reported by the
            edit-mode service while a drag is in progress. It sits above the widgets but is
            hit-test-invisible so it never interferes with dragging; the list is empty outside a
            snapping drag, so nothing is rendered and nothing is persisted.
        -->
        <ItemsControl x:Name="GuideLayer"
                      Grid.Row="0"
                      Grid.RowSpan="2"
                      ItemsSource="{Binding ActiveGuides}"
                      IsHitTestVisible="False"
                      Focusable="False"
                      IsTabStop="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas Background="Transparent" IsHitTestVisible="False" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Line X1="{Binding X1}"
                          Y1="{Binding Y1}"
                          X2="{Binding X2}"
                          Y2="{Binding Y2}"
                          Stroke="{DynamicResource PanelAccentBrush}"
                          StrokeThickness="1"
                          StrokeDashArray="4 3"
                          IsHitTestVisible="False" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--
            M5-RF-502/M5-RF-504: the in-overlay "Are you sure?" confirmation. It is not a window and
            never activates the panel; both buttons are touch-sized (>= 44 DIP) and Focusable=false so
            the edit-mode keyboard shortcuts keep working. Confirm routes to the existing remove path;
            cancel changes nothing.
        -->
        <Border x:Name="DeleteConfirmation"
                Grid.Row="0"
                Grid.RowSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="20"
                Background="#EE1E1E1E"
                BorderBrush="{DynamicResource PanelAccentBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Focusable="False"
                Visibility="{Binding IsDeleteConfirmationVisible, Converter={StaticResource EditModeVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel Focusable="False">
                <TextBlock Text="Are you sure?"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource PanelForegroundBrush}" />
                <TextBlock Text="Delete the selected widget?"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource PanelForegroundBrush}" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,14,0,0"
                            Focusable="False">
                    <Button x:Name="CancelDeleteButton"
                            Style="{StaticResource EditToolbarButtonStyle}"
                            Content="Cancel"
                            Click="OnCancelDeleteClick" />
                    <Button x:Name="ConfirmDeleteButton"
                            Style="{StaticResource EditToolbarButtonStyle}"
                            Content="Delete"
                            Click="OnConfirmDeleteClick" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--
            T-13 widget palette and lifecycle toolbar (RF-043/M2-RF-431/M2-RF-432): the palette lists
            only the built-in types (M2-RF-430), and Duplicate/Remove act on the current selection.
            It only exists while edit mode is active because it lives inside the edit-mode root.

            Layout fix (RF-023/RNF-015): the strip is wider than the 1024x600 panel, so the toolbar
            uses a vertical two-row layout. Row 0 is the action cluster (Snap / Duplicate / Remove /
            Exit Edit Mode) in a WrapPanel that wraps to a second line if the panel is narrower than
            the cluster, so Exit Edit Mode is unmistakably always on-screen and touch-reachable. Row 1
            is the palette in a ScrollViewer that scrolls/pans horizontally when it overflows. The
            toolbar stretches only within the panel width (the overlay root is width-constrained), so
            nothing is ever pushed off the panel at any palette size or DPI scaling. PanningMode lets
            touch drag the palette without a keyboard or mouse.
        -->
        <Border x:Name="EditToolbar"
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                Margin="10,0,10,10"
                Padding="8,4"
                Background="#CC1E1E1E"
                CornerRadius="12"
                Focusable="False">
            <Grid Focusable="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                    Row 0: the action cluster. It is laid out above the palette and wraps within the
                    panel width, so no action can ever be scrolled or clipped off the panel.
                -->
                <WrapPanel x:Name="ActionCluster"
                           Grid.Row="0"
                           Orientation="Horizontal"
                           HorizontalAlignment="Left"
                           Focusable="False">
                    <!-- T-15 snap toggle (M2-RF-441/M2-RF-445): touch on/off for grid snap + alignment. -->
                    <ToggleButton x:Name="SnapToggleButton"
                                  Style="{StaticResource EditToolbarToggleStyle}"
                                  Content="Snap"
                                  IsChecked="{Binding IsSnapEnabled, Mode=OneWay}"
                                  Click="OnToggleSnapClick" />

                    <!-- User-requested: manage pages without leaving edit mode. The toggle opens the
                         inline pages surface; structural changes save the pending layout, apply
                         through the single-writer settings coordinator, and re-enter edit mode. -->
                    <ToggleButton x:Name="PagesToggleButton"
                                  Style="{StaticResource EditToolbarToggleStyle}"
                                  Content="Pages…"
                                  Checked="OnPagesToggleChecked" />

                    <Button x:Name="DuplicateButton"
                            Style="{StaticResource EditToolbarButtonStyle}"
                            Content="Duplicate"
                            IsEnabled="{Binding CanModifySelection}"
                            Click="OnDuplicateWidgetClick" />
                    <Button x:Name="RemoveButton"
                            Style="{StaticResource EditToolbarButtonStyle}"
                            Content="Remove"
                            IsEnabled="{Binding CanModifySelection}"
                            Click="OnRemoveWidgetClick" />

                    <Border Width="1" Height="32" VerticalAlignment="Center" Margin="8,0" Background="{DynamicResource WidgetBorderBrush}" />

                    <!-- Exits edit mode through the same composition-root path as Esc/tray: persist when
                         dirty, then restore the non-activating normal mode. The window forwards this
                         request; the overlay never activates the panel itself. -->
                    <Button x:Name="ExitEditModeButton"
                            Style="{StaticResource EditToolbarButtonStyle}"
                            Content="Exit Edit Mode"
                            Click="OnExitEditModeClick" />
                </WrapPanel>

                <!--
                    Row 1: the palette. Horizontally scrollable (or touch-pannable) so it can never
                    push anything off the panel; PanningMode lets touch drag the palette without a
                    keyboard or mouse.
                -->
                <ScrollViewer Grid.Row="1"
                              x:Name="PaletteScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              PanningMode="HorizontalOnly"
                              Focusable="False"
                              IsTabStop="False">
                    <ItemsControl x:Name="PaletteItems"
                                  ItemsSource="{Binding PaletteItems}"
                                  VerticalAlignment="Center"
                                  Focusable="False"
                                  IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource EditToolbarButtonStyle}"
                                        Content="{Binding DisplayName}"
                                        Tag="{Binding Type}"
                                        ToolTip="{Binding Type}"
                                        Click="OnAddWidgetClick" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!--
            T-13 property editor panel (RF-043/M2-RF-433): edits the selected widget's position,
            size, label, and type-specific properties. It collapses when the service reports no
            editable selection (unknown widget types never get one). The Apply button is focusable
            on purpose so a tap pulls focus away from the active text field, committing its value
            even when the touch keyboard offers no explicit done action.
        -->
        <Border x:Name="PropertyPanel"
                Grid.Row="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,10,0"
                Width="300"
                MaxHeight="560"
                Padding="12,12,16,12"
                Background="#CC1E1E1E"
                BorderBrush="{DynamicResource WidgetBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Focusable="False"
                Visibility="{Binding HasPropertyEditor, Converter={StaticResource EditModeVisibilityConverter}, FallbackValue=Collapsed}">
            <ContentControl Content="{Binding PropertyEditor}" Focusable="False">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel Focusable="False">
                                <TextBlock Text="{Binding TypeDisplayName}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PanelForegroundBrush}" />

                                <TextBlock Text="Label" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                <TextBox x:Name="LabelBox"
                                         Text="{Binding LabelText, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource EditPropertyTextBoxStyle}" />

                                <!--
                                    T-14 label/icon/colors (RF-043/M2-RF-435/M2-RF-436): pick a built-in
                                    icon and apply per-widget appearance overrides. Empty fields mean
                                    "use the theme default". Touch-first and dialog-less.
                                -->
                                <StackPanel x:Name="AppearanceSection"
                                            Focusable="False"
                                            Visibility="{Binding SupportsAppearance, Converter={StaticResource EditModeVisibilityConverter}}">
                                    <TextBlock Text="Icon" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                    <ComboBox x:Name="IconBox"
                                              MinHeight="40"
                                              FontSize="15"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding IconOptions}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedItem="{Binding SelectedIcon}" />

                                    <TextBlock Text="Foreground (#RRGGBB)" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                    <TextBox x:Name="ForegroundBox"
                                             Text="{Binding ForegroundText, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource EditPropertyTextBoxStyle}" />

                                    <TextBlock Text="Background (#RRGGBB)" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                    <TextBox x:Name="BackgroundBox"
                                             Text="{Binding BackgroundText, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource EditPropertyTextBoxStyle}" />

                                    <TextBlock Text="Accent (#RRGGBB)" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                    <TextBox x:Name="AccentBox"
                                             Text="{Binding AccentText, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource EditPropertyTextBoxStyle}" />

                                    <UniformGrid Columns="2" Margin="0,6,0,0">
                                        <StackPanel Margin="0,0,4,0" Focusable="False">
                                            <TextBlock Text="Font size (8-96)" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                            <TextBox x:Name="FontSizeBox"
                                                     Text="{Binding FontSizeText, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource EditPropertyTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Margin="4,0,0,0" Focusable="False">
                                            <TextBlock Text="Opacity (0-1)" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                            <TextBox x:Name="OpacityBox"
                                                     Text="{Binding OpacityText, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource EditPropertyTextBoxStyle}" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>

                                <!--
                                    T-14 action picker (RF-043/M2-RF-434): choose the action type bound
                                    to the selected Button/Toggle and edit its typed parameters. The
                                    run-command ("open program") action exposes an executable browse.
                                    Available only for action-bearing widgets (HasActionPicker).
                                -->
                                <StackPanel x:Name="ActionPickerSection"
                                            Focusable="False"
                                            Visibility="{Binding HasActionPicker, Converter={StaticResource EditModeVisibilityConverter}}">
                                    <TextBlock Text="Action" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                    <ComboBox x:Name="ActionTypeBox"
                                              MinHeight="40"
                                              FontSize="15"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding ActionPicker.ActionTypeOptions}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedItem="{Binding ActionPicker.SelectedActionOption}" />

                                    <!-- Run command / open program -->
                                    <StackPanel x:Name="ActionRunCommandSection"
                                                Focusable="False"
                                                Visibility="{Binding ActionPicker.CanEditRunCommand, Converter={StaticResource EditModeVisibilityConverter}}">
                                        <TextBlock Text="Executable" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ActionPathBox"
                                                     Grid.Column="0"
                                                     Text="{Binding ActionPicker.PathText, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource EditPropertyTextBoxStyle}" />
                                            <Button x:Name="ActionBrowseButton"
                                                    Grid.Column="1"
                                                    Margin="4,0,0,0"
                                                    Style="{StaticResource EditToolbarButtonStyle}"
                                                    Content="Browse"
                                                    Command="{Binding ActionPicker.BrowseExecutableCommand}" />
                                        </Grid>
                                        <TextBlock Text="Arguments (one per line)" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                        <TextBox x:Name="ActionArgumentsBox"
                                                 Text="{Binding ActionPicker.ArgumentsText, UpdateSourceTrigger=LostFocus}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="NoWrap"
                                                 MinHeight="64"
                                                 Style="{StaticResource EditPropertyTextBoxStyle}" />
                                        <TextBlock Text="Working directory" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                        <TextBox x:Name="ActionWorkingDirectoryBox"
                                                 Text="{Binding ActionPicker.WorkingDirectoryText, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource EditPropertyTextBoxStyle}" />
                                    </StackPanel>

                                    <!-- Send keys -->
                                    <StackPanel Focusable="False"
                                                Visibility="{Binding ActionPicker.CanEditSendKeys, Converter={StaticResource EditModeVisibilityConverter}}">
                                        <TextBlock Text="Key" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                        <TextBox x:Name="ActionKeyBox"
                                                 Text="{Binding ActionPicker.KeyText, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource EditPropertyTextBoxStyle}" />
                                        <TextBlock Text="Modifiers" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                        <WrapPanel>
                                            <CheckBox x:Name="ActionCtrlBox"
                                                      Content="Ctrl"
                                                      IsChecked="{Binding ActionPicker.ModifierCtrl}"
                                                      Style="{StaticResource EditPropertyCheckBoxStyle}" />
                                            <CheckBox x:Name="ActionAltBox"
                                                      Content="Alt"
                                                      Margin="12,0,0,0"
                                                      IsChecked="{Binding ActionPicker.ModifierAlt}"
                                                      Style="{StaticResource EditPropertyCheckBoxStyle}" />
                                            <CheckBox x:Name="ActionShiftBox"
                                                      Content="Shift"
                                                      Margin="12,0,0,0"
                                                      IsChecked="{Binding ActionPicker.ModifierShift}"
                                                      Style="{StaticResource EditPropertyCheckBoxStyle}" />
                                            <CheckBox x:Name="ActionWinBox"
                                                      Content="Win"
                                                      Margin="12,0,0,0"
                                                      IsChecked="{Binding ActionPicker.ModifierWin}"
                                                      Style="{StaticResource EditPropertyCheckBoxStyle}" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Media key -->
                                    <StackPanel Focusable="False"
                                                Visibility="{Binding ActionPicker.CanEditMediaKey, Converter={StaticResource EditModeVisibilityConverter}}">
                                        <TextBlock Text="Media key" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                        <ComboBox x:Name="ActionMediaKeyBox"
                                                  MinHeight="40"
                                                  FontSize="15"
                                                  HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding ActionPicker.MediaKeyOptions}"
                                                  SelectedItem="{Binding ActionPicker.SelectedMediaKey}" />
                                    </StackPanel>

                                    <!-- Volume -->
                                    <StackPanel Focusable="False"
                                                Visibility="{Binding ActionPicker.CanEditVolume, Converter={StaticResource EditModeVisibilityConverter}}">
                                        <TextBlock Text="Volume mode" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                        <ComboBox x:Name="ActionVolumeModeBox"
                                                  MinHeight="40"
                                                  FontSize="15"
                                                  HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding ActionPicker.VolumeModeOptions}"
                                                  SelectedItem="{Binding ActionPicker.SelectedVolumeMode}" />
                                        <StackPanel Focusable="False"
                                                    Visibility="{Binding ActionPicker.IsVolumeSetMode, Converter={StaticResource EditModeVisibilityConverter}}">
                                            <TextBlock Text="Level (0-100)" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                            <TextBox x:Name="ActionVolumeLevelBox"
                                                     Text="{Binding ActionPicker.LevelText, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource EditPropertyTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Focusable="False"
                                                    Visibility="{Binding ActionPicker.IsVolumeStepMode, Converter={StaticResource EditModeVisibilityConverter}}">
                                            <TextBlock Text="Direction" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                            <ComboBox x:Name="ActionVolumeDirectionBox"
                                                      MinHeight="40"
                                                      FontSize="15"
                                                      HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding ActionPicker.VolumeDirectionOptions}"
                                                      SelectedItem="{Binding ActionPicker.SelectedVolumeDirection}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Hotkey reference (M5-RF-522): choose a configured global
                                         hotkey; an empty list shows a clear state, never a blank. -->
                                    <StackPanel x:Name="ActionHotkeySection"
                                                Focusable="False"
                                                Visibility="{Binding ActionPicker.CanEditHotkey, Converter={StaticResource EditModeVisibilityConverter}}">
                                        <TextBlock Text="Hotkey" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                        <ComboBox x:Name="ActionHotkeyBox"
                                                  MinHeight="40"
                                                  FontSize="15"
                                                  HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding ActionPicker.HotkeyOptions}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedItem="{Binding ActionPicker.SelectedHotkey}"
                                                  Visibility="{Binding ActionPicker.HasHotkeys, Converter={StaticResource EditModeVisibilityConverter}, FallbackValue=Collapsed}" />
                                        <TextBlock x:Name="ActionHotkeyEmptyText"
                                                   Text="No hotkeys configured yet."
                                                   Margin="0,4,0,0"
                                                   Foreground="{DynamicResource PanelDisabledForegroundBrush}"
                                                   Visibility="{Binding ActionPicker.HasNoHotkeys, Converter={StaticResource EditModeVisibilityConverter}, FallbackValue=Collapsed}" />
                                    </StackPanel>

                                    <TextBlock x:Name="ActionValidationText"
                                               Text="{Binding ActionPicker.ValidationError}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"
                                               Foreground="#FFFF6B6B"
                                               Visibility="{Binding ActionPicker.HasValidationError, Converter={StaticResource EditModeVisibilityConverter}, FallbackValue=Collapsed}" />
                                </StackPanel>

                                <TextBlock Text="Position &amp; size (DIP)" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,4,0" Focusable="False">
                                        <TextBlock Text="X" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                        <TextBox x:Name="XBox"
                                                 Text="{Binding XText, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource EditPropertyTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,0" Focusable="False">
                                        <TextBlock Text="Y" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                        <TextBox x:Name="YBox"
                                                 Text="{Binding YText, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource EditPropertyTextBoxStyle}" />
                                    </StackPanel>
                                </UniformGrid>
                                <UniformGrid Columns="2" Margin="0,6,0,0">
                                    <StackPanel Margin="0,0,4,0" Focusable="False">
                                        <TextBlock Text="Width" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                        <TextBox x:Name="WidthBox"
                                                 Text="{Binding WidthText, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource EditPropertyTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,0" Focusable="False">
                                        <TextBlock Text="Height" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                        <TextBox x:Name="HeightBox"
                                                 Text="{Binding HeightText, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource EditPropertyTextBoxStyle}" />
                                    </StackPanel>
                                </UniformGrid>

                                <StackPanel Focusable="False"
                                            Visibility="{Binding HasSensor, Converter={StaticResource EditModeVisibilityConverter}}">
                                    <TextBlock Text="Sensor" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                    <ComboBox x:Name="SensorBox"
                                              MinHeight="40"
                                              FontSize="15"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding SensorOptions}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedItem="{Binding SelectedSensor}" />
                                </StackPanel>

                                <StackPanel Focusable="False"
                                            Visibility="{Binding HasRange, Converter={StaticResource EditModeVisibilityConverter}}">
                                    <TextBlock Text="Range" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,4,0" Focusable="False">
                                            <TextBlock Text="Minimum" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                            <TextBox x:Name="MinBox"
                                                     Text="{Binding MinimumText, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource EditPropertyTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Margin="4,0,0,0" Focusable="False">
                                            <TextBlock Text="Maximum" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                            <TextBox x:Name="MaxBox"
                                                     Text="{Binding MaximumText, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource EditPropertyTextBoxStyle}" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>

                                <!-- User-requested: byte/data-rate display unit (Gauge/Bar). Only
                                     meaningful for byte/rate sensors; ignored otherwise. -->
                                <StackPanel Focusable="False"
                                            Visibility="{Binding HasDisplayUnit, Converter={StaticResource EditModeVisibilityConverter}}">
                                    <TextBlock Text="Value unit (byte/rate sensors)" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                    <ComboBox x:Name="DisplayUnitBox"
                                              MinHeight="40"
                                              FontSize="15"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding DisplayUnitOptions}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedItem="{Binding SelectedDisplayUnit}" />
                                </StackPanel>

                                <StackPanel Focusable="False"
                                            Visibility="{Binding HasStep, Converter={StaticResource EditModeVisibilityConverter}}">
                                    <TextBlock Text="Step" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                    <TextBox x:Name="StepBox"
                                             Text="{Binding StepText, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource EditPropertyTextBoxStyle}" />
                                </StackPanel>

                                <StackPanel Focusable="False"
                                            Visibility="{Binding HasInitialValue, Converter={StaticResource EditModeVisibilityConverter}}">
                                    <TextBlock Text="Initial value" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                    <TextBox x:Name="InitialValueBox"
                                             Text="{Binding InitialValueText, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource EditPropertyTextBoxStyle}" />
                                </StackPanel>

                                <StackPanel Focusable="False"
                                            Visibility="{Binding HasOrientation, Converter={StaticResource EditModeVisibilityConverter}}">
                                    <TextBlock Text="Orientation" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                    <ComboBox x:Name="OrientationBox"
                                              MinHeight="40"
                                              FontSize="15"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding OrientationOptions}"
                                              SelectedItem="{Binding SelectedOrientation}" />
                                </StackPanel>

                                <StackPanel Focusable="False"
                                            Visibility="{Binding HasWindow, Converter={StaticResource EditModeVisibilityConverter}}">
                                    <TextBlock Text="Window (s)" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                    <TextBox x:Name="WindowBox"
                                             Text="{Binding WindowText, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource EditPropertyTextBoxStyle}" />
                                </StackPanel>

                                <StackPanel Focusable="False"
                                            Visibility="{Binding HasStyle, Converter={StaticResource EditModeVisibilityConverter}}">
                                    <TextBlock Text="Style" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                    <ComboBox x:Name="StyleBox"
                                              MinHeight="40"
                                              FontSize="15"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding StyleOptions}"
                                              SelectedItem="{Binding SelectedStyle}" />
                                </StackPanel>

                                <StackPanel Focusable="False"
                                            Visibility="{Binding HasPersistState, Converter={StaticResource EditModeVisibilityConverter}}">
                                    <CheckBox x:Name="PersistStateBox"
                                              Content="Persist state"
                                              IsChecked="{Binding PersistState}"
                                              Style="{StaticResource EditPropertyCheckBoxStyle}" />
                                    <CheckBox x:Name="InitialOnBox"
                                              Content="Initial on"
                                              IsChecked="{Binding InitialOn}"
                                              Style="{StaticResource EditPropertyCheckBoxStyle}" />
                                </StackPanel>

                                <!--
                                    M4-RF-432: type-specific fields for the M3 widget types (Clock,
                                    ImageButton, Bar) so they are edited in the property editor
                                    instead of by hand-editing panel.json. Each section is gated by
                                    its Has* flag; validation reuses the ConfigValidator rules.
                                -->
                                <StackPanel Focusable="False"
                                            Visibility="{Binding HasMode, Converter={StaticResource EditModeVisibilityConverter}}">
                                    <TextBlock Text="Mode" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                    <ComboBox x:Name="ClockModeBox"
                                              MinHeight="40"
                                              FontSize="15"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding ModeOptions}"
                                              SelectedItem="{Binding SelectedMode}" />
                                </StackPanel>

                                <StackPanel Focusable="False"
                                            Visibility="{Binding HasFormat, Converter={StaticResource EditModeVisibilityConverter}}">
                                    <TextBlock Text="Format (blank = preset)" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                    <TextBox x:Name="ClockFormatBox"
                                             Text="{Binding FormatText, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource EditPropertyTextBoxStyle}" />
                                </StackPanel>

                                <StackPanel Focusable="False"
                                            Visibility="{Binding HasShowLabel, Converter={StaticResource EditModeVisibilityConverter}}">
                                    <CheckBox x:Name="ShowLabelBox"
                                              Content="Show label"
                                              IsChecked="{Binding ShowLabel}"
                                              Style="{StaticResource EditPropertyCheckBoxStyle}" />
                                </StackPanel>

                                <StackPanel Focusable="False"
                                            Visibility="{Binding HasShowValue, Converter={StaticResource EditModeVisibilityConverter}}">
                                    <CheckBox x:Name="ShowValueBox"
                                              Content="Show value"
                                              IsChecked="{Binding ShowValue}"
                                              Style="{StaticResource EditPropertyCheckBoxStyle}" />
                                </StackPanel>

                                <!-- Image (user-requested): absolute file path + fit mode. The path
                                     can be typed or chosen with the native image browse. -->
                                <StackPanel Focusable="False"
                                            Visibility="{Binding HasImagePath, Converter={StaticResource EditModeVisibilityConverter}}">
                                    <TextBlock Text="Image path (absolute)" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ImagePathBox"
                                                 Grid.Column="0"
                                                 Text="{Binding ImagePathText, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource EditPropertyTextBoxStyle}" />
                                        <Button x:Name="ImageBrowseButton"
                                                Grid.Column="1"
                                                Margin="4,0,0,0"
                                                Style="{StaticResource EditToolbarButtonStyle}"
                                                Content="Browse"
                                                IsEnabled="{Binding CanBrowseImage}"
                                                Command="{Binding BrowseImageCommand}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Focusable="False"
                                            Visibility="{Binding HasStretch, Converter={StaticResource EditModeVisibilityConverter}}">
                                    <TextBlock Text="Fit" Style="{StaticResource EditPropertySectionLabelStyle}" />
                                    <ComboBox x:Name="ImageStretchBox"
                                              MinHeight="40"
                                              FontSize="15"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding StretchOptions}"
                                              SelectedItem="{Binding SelectedStretch}" />
                                </StackPanel>

                                <TextBlock x:Name="ValidationText"
                                           Text="{Binding ValidationError}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Foreground="#FFFF6B6B"
                                           Visibility="{Binding HasValidationError, Converter={StaticResource EditModeVisibilityConverter}, FallbackValue=Collapsed}" />

                                <!-- Focusable so a tap commits the active text field (LostFocus);
                                     the explicit command performs the idempotent Apply commit (M5-RF-531). -->
                                <Button x:Name="PropertyApplyButton"
                                        Style="{StaticResource EditToolbarButtonStyle}"
                                        Focusable="True"
                                        Content="Apply"
                                        Command="{Binding ApplyCommand}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,10,0,0"
                                        Padding="12,8" />

                                <!-- UX fix #3b: closes the edit menu without leaving edit mode. Kept
                                     focusable so a tap commits the focused field (LostFocus) before
                                     the panel is dismissed; touch-sized (>= 40 DIP) via the toolbar
                                     button style. -->
                                <Button x:Name="PropertyCloseButton"
                                        Style="{StaticResource EditToolbarButtonStyle}"
                                        Focusable="True"
                                        Content="Close"
                                        Click="OnClosePropertyEditorClick"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,8,0,0"
                                        Padding="12,8" />
                            </StackPanel>
                        </ScrollViewer>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>

        <!--
            User-requested: pages management inside edit mode. It reuses the existing touch pages
            editor, so add/rename/remove/open keep the same single-writer persistence and guards. The
            surface is shown only while the toolbar's Pages toggle is checked and collapses with the
            whole overlay outside edit mode; it sits on the left so it never covers the property
            panel on the right. Controls inside remain touch-sized (>= 40 DIP) and theme-aware
            through the editor's dynamic resources.
        -->
        <Border x:Name="PagesPanel"
                Grid.Row="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Margin="10,10,0,0"
                Width="350"
                MaxHeight="560"
                Padding="12"
                Background="#CC1E1E1E"
                BorderBrush="{DynamicResource WidgetBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="{Binding IsChecked, ElementName=PagesToggleButton, Converter={StaticResource EditModeVisibilityConverter}, FallbackValue=Collapsed}">
            <DockPanel LastChildFill="True" Focusable="False">
                <Button x:Name="ClosePagesButton"
                        DockPanel.Dock="Top"
                        Style="{StaticResource EditToolbarButtonStyle}"
                        Content="Close pages"
                        HorizontalAlignment="Right"
                        Margin="0,0,0,6"
                        Click="OnClosePagesClick" />
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <settingsViews:PagesEditorView x:Name="PagesEditor" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
