<Window x:Class="TouchPanel.Views.About.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About TouchPanel"
        Icon="/TouchPanel;component/Assets/touchpanel.ico"
        Width="500"
        Height="470"
        MinWidth="420"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ShowActivated="True"
        Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource PanelForegroundBrush}"
        TextOptions.TextFormattingMode="Display">

    <!--
        User-requested About / version window. It is an ordinary activating window because it is
        opened only by a deliberate tray selection; the panel keeps its no-activate behavior. It
        performs no network work on open: the update check runs only when the user presses the
        button, through the injectable IUpdateCheckService seam.
    -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TouchPanel;component/Theme/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Both About button styles build on the shared themed base (Theme/Styles.xaml) so they
                inherit ThemedButtonTemplate: the stock WPF hover brush (a light system color) no
                longer overwrites the theme surface, and the hover/pressed/disabled states use the
                themed pressed/disabled surfaces with a readable foreground.
            -->
            <Style x:Key="AboutButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemedButtonStyle}">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Background" Value="{DynamicResource WidgetSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PanelForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WidgetBorderBrush}" />
            </Style>

            <Style x:Key="AboutLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource AboutButtonStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource PanelAccentBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Style.Triggers>
                    <!-- The accent on the themed pressed surface is only ~3:1 in the dark palettes, so
                         a hovered link switches to the theme foreground (~9:1+) on the same surface. -->
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource PanelForegroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource PanelDisabledForegroundBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="AboutStatusTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Identity (name + assembly informational version) -->
        <TextBlock x:Name="AppNameText"
                   Grid.Row="0"
                   Text="{Binding AppName}"
                   FontSize="26"
                   FontWeight="SemiBold" />

        <TextBlock x:Name="VersionTextBlock"
                   Grid.Row="1"
                   Text="{Binding VersionText}"
                   FontSize="14"
                   Opacity="0.8"
                   Margin="0,2,0,0" />

        <TextBlock x:Name="DescriptionText"
                   Grid.Row="2"
                   Text="{Binding Description}"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Margin="0,14,0,0" />

        <!-- Links -->
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="Links"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PanelAccentBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button x:Name="RepositoryButton"
                        Content="GitHub repository"
                        Style="{StaticResource AboutLinkButtonStyle}"
                        Command="{Binding OpenRepositoryCommand}"
                        Margin="0,0,20,0" />
                <Button x:Name="ReleasesButton"
                        Content="Releases"
                        Style="{StaticResource AboutLinkButtonStyle}"
                        Command="{Binding OpenReleasesCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- Manual update check -->
        <Border Grid.Row="4"
                Margin="0,16,0,0"
                Padding="14"
                CornerRadius="8"
                Background="{DynamicResource WidgetSurfaceBrush}"
                BorderBrush="{DynamicResource WidgetBorderBrush}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Updates"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PanelAccentBrush}" />

                <TextBlock x:Name="UpdateStatusText"
                           Style="{StaticResource AboutStatusTextStyle}"
                           Text="{Binding StatusMessage}"
                           Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolVisibilityConverter}}" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="CheckForUpdatesButton"
                            Content="Check for updates"
                            Style="{StaticResource AboutButtonStyle}"
                            Command="{Binding CheckForUpdatesCommand}"
                            IsEnabled="{Binding CanCheckForUpdates}"
                            Margin="0,0,8,0" />
                    <Button x:Name="OpenReleaseButton"
                            Content="Open release"
                            Style="{StaticResource AboutButtonStyle}"
                            Command="{Binding OpenReleaseCommand}"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolVisibilityConverter}}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Deliberate-action window controls -->
        <Button x:Name="CloseButton"
                Grid.Row="6"
                Content="Close"
                Style="{StaticResource AboutButtonStyle}"
                MinWidth="120"
                HorizontalAlignment="Right"
                IsCancel="True"
                Click="OnCloseClick" />
    </Grid>
</Window>
