<UserControl x:Class="TouchPanel.Views.PageSwitcherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             IsTabStop="False"
             Stylus.IsPressAndHoldEnabled="False"
             Stylus.IsFlicksEnabled="False">

    <!--
        In-panel page selector (T-16, RF-091/M2-RF-911/M2-RF-913): a touch-first tab strip that
        switches the active page without activating the panel or changing the foreground. It is bound
        to a PageSwitcherViewModel, collapses when only one page is configured, and is covered by the
        edit overlay while editing so a switch can never discard an edit session. Every affordance is
        at least 44 DIP and none depends on hover (RF-025); controls are non-focusable so normal
        operation never requires keyboard focus.
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Self-contained: resolves the theme brushes without App resources. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TouchPanel;component/Theme/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="PageSwitcherVisibilityConverter" />

            <!--
                Phone-homepage page dot (non-interactive indicator): the active dot is accent-filled
                and slightly larger so the current page is visible without hover. Dots are not
                focusable and never take pointer input; the tab strip above remains the switch
                affordance.
            -->
            <Style x:Key="PageDotStyle" TargetType="Ellipse">
                <Setter Property="Width" Value="10" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Margin" Value="5,0" />
                <Setter Property="Fill" Value="{DynamicResource WidgetBorderBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="Width" Value="13" />
                        <Setter Property="Height" Value="13" />
                        <Setter Property="Fill" Value="{DynamicResource PanelAccentBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Touch-first page tab (>= 44 DIP). The active page is highlighted with the accent
                 border, visible without hover (RF-025). -->
            <Style x:Key="PageTabButtonStyle" TargetType="ButtonBase">
                <Setter Property="MinWidth" Value="48" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="Foreground" Value="{DynamicResource PanelForegroundBrush}" />
                <Setter Property="Background" Value="{DynamicResource WidgetSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WidgetBorderBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ButtonBase">
                            <Border x:Name="Surface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource WidgetPressedBrush}" />
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PanelAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource PanelAccentBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="SelectorRoot"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Visibility="{Binding CanSwitch, Converter={StaticResource PageSwitcherVisibilityConverter}, FallbackValue=Collapsed}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Existing touch tab strip, kept usable above the pager. -->
        <Border Grid.Row="0"
                HorizontalAlignment="Center"
                Margin="0,8,0,0"
                Background="#CC1E1E1E"
                BorderBrush="{DynamicResource WidgetBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="4"
                Focusable="False">
            <ItemsControl x:Name="PageItems"
                          ItemsSource="{Binding Pages}"
                          Focusable="False"
                          IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="PageTabButton"
                                Style="{StaticResource PageTabButtonStyle}"
                                Content="{Binding DisplayName}"
                                Tag="{Binding Id}"
                                Command="{Binding DataContext.SelectPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Id}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!--
            Phone-homepage indicator: one dot per page plus a "current / count" label at the bottom
            center. It is hit-test-invisible so it can never block a widget tap; the active page and
            the total are visible in normal mode without hover or keyboard focus.
        -->
        <Border x:Name="PageIndicator"
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,12"
                Padding="12,6"
                Background="#CC1E1E1E"
                BorderBrush="{DynamicResource WidgetBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                IsHitTestVisible="False"
                Focusable="False">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Focusable="False">
                <ItemsControl x:Name="PageDots"
                              ItemsSource="{Binding Pages}"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False"
                              Focusable="False"
                              IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Ellipse x:Name="PageDot"
                                     Style="{StaticResource PageDotStyle}"
                                     ToolTip="{Binding DisplayName}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="PageIndicatorText"
                           Text="{Binding PageIndicatorText}"
                           Margin="10,0,0,0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PanelForegroundBrush}"
                           IsHitTestVisible="False" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
