<UserControl x:Class="TouchPanel.Views.Settings.PagesEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TouchPanel.Views.Controls"
             Focusable="False"
             IsTabStop="False">

    <!--
        Touch pages management (user-requested): add, select, open (switch active), rename, and
        remove pages. Every actionable affordance is at least 40 DIP tall, uses the existing theme
        brushes through DynamicResource, and has visible press/selected states (no hover-only
        affordance). Removing the last page is blocked by the view model and the bound IsEnabled.
        The view is pure XAML over PagesEditorViewModel; the composition root assigns it.
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TouchPanel;component/Theme/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="PagesBoolToVisibilityConverter" />

            <Style x:Key="PagesSectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource PanelAccentBrush}" />
                <Setter Property="Margin" Value="0,12,0,6" />
            </Style>

            <Style x:Key="PagesFieldStyle" TargetType="TextBox">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Foreground" Value="{DynamicResource PanelForegroundBrush}" />
                <Setter Property="Background" Value="{DynamicResource WidgetSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WidgetBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="PagesButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource PanelForegroundBrush}" />
                <Setter Property="Background" Value="{DynamicResource WidgetSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WidgetBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource WidgetPressedBrush}" />
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PanelAccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PagesRowSelectButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource PagesButtonStyle}">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Margin" Value="0" />
            </Style>

            <Style x:Key="PagesRowContainerStyle" TargetType="Border">
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="Background" Value="{DynamicResource WidgetSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WidgetBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource PanelAccentBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Focusable="False">
        <TextBlock Text="Pages" Style="{StaticResource PagesSectionHeaderStyle}" />

        <!-- Add a page: unique id and generated/entered label; appended after the current pages. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewPageNameBox"
                     Grid.Column="0"
                     Margin="0,0,8,0"
                     Style="{StaticResource PagesFieldStyle}"
                     Text="{Binding NewPageName, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="New page name (blank = generated 'Page N')" />
            <Button x:Name="AddPageButton"
                    Grid.Column="1"
                    Style="{StaticResource PagesButtonStyle}"
                    Content="Add page"
                    IsEnabled="{Binding CanAddPage}"
                    Command="{Binding AddPageCommand}" />
        </Grid>

        <!-- Page list: tap a row to select; drag a row up/down to reorder; Open makes it active;
             Remove asks for confirmation. The drop caret overlays the list while dragging. -->
        <Grid x:Name="PageListHost" Margin="0,8,0,0">
            <!--
                The rows own a vertical drag-to-reorder gesture, so panning is excluded for a touch
                that starts inside the list. A pan in the pages surface still starts from the panel
                chrome, the fields, and every other area; Move up / Move down remain the touch
                fallback for reordering.
            -->
            <ItemsControl x:Name="PageItems"
                          ItemsSource="{Binding Pages}"
                          Focusable="False"
                          IsTabStop="False"
                          controls:TouchPan.IsPanExcluded="True"
                          PreviewMouseLeftButtonDown="OnPageListPreviewMouseLeftButtonDown"
                          PreviewMouseMove="OnPageListPreviewMouseMove"
                          PreviewMouseLeftButtonUp="OnPageListPreviewMouseLeftButtonUp"
                          LostMouseCapture="OnPageListLostMouseCapture">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="PageRow" Style="{StaticResource PagesRowContainerStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="SelectPageRowButton"
                                        Grid.Column="0"
                                        Style="{StaticResource PagesRowSelectButtonStyle}"
                                        Command="{Binding DataContext.SelectPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Id}"
                                        AutomationProperties.Name="{Binding DisplayName}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x2630;"
                                                   Margin="0,0,8,0"
                                                   FontSize="15"
                                                   Opacity="0.7"
                                                   VerticalAlignment="Center"
                                                   ToolTip="Drag up or down to reorder" />
                                        <TextBlock Text="{Binding Position, StringFormat={}{0}.}"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DisplayName}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="Active"
                                                   Margin="10,0,0,0"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PanelAccentBrush}"
                                                   Visibility="{Binding IsActive, Converter={StaticResource PagesBoolToVisibilityConverter}}" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="OpenPageButton"
                                        Grid.Column="1"
                                        Content="Open"
                                        Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Id}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PagesButtonStyle}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button x:Name="RemovePageButton"
                                        Grid.Column="2"
                                        Style="{StaticResource PagesButtonStyle}"
                                        Content="Remove"
                                        Margin="0"
                                        IsEnabled="{Binding DataContext.CanRemoveSelected, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        Command="{Binding DataContext.RequestRemovePageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Id}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Insertion caret: a transient, non-hit-testable accent line at the resolved drop slot. -->
            <Border x:Name="PageDropIndicator"
                    Height="4"
                    Margin="0,0,0,0"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource PanelAccentBrush}"
                    CornerRadius="2"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"
                    AutomationProperties.Name="Page drop position" />
        </Grid>

        <TextBlock Text="Drag a page up or down to reorder."
                   FontSize="13"
                   Margin="0,6,0,0"
                   Opacity="0.8"
                   Foreground="{DynamicResource PanelForegroundBrush}" />

        <!-- Robust touch fallback for reordering when a drag is not practical. -->
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Focusable="False">
            <Button x:Name="MovePageUpButton"
                    Style="{StaticResource PagesButtonStyle}"
                    Content="Move up"
                    AutomationProperties.Name="Move selected page up"
                    IsEnabled="{Binding CanMoveSelectedUp}"
                    Command="{Binding MovePageUpCommand}" />
            <Button x:Name="MovePageDownButton"
                    Style="{StaticResource PagesButtonStyle}"
                    Content="Move down"
                    AutomationProperties.Name="Move selected page down"
                    IsEnabled="{Binding CanMoveSelectedDown}"
                    Command="{Binding MovePageDownCommand}" />
        </StackPanel>

        <!-- Rename the selected page. -->
        <TextBlock Text="Selected page name" FontSize="13" Margin="0,6,0,2" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SelectedPageNameBox"
                     Grid.Column="0"
                     Margin="0,0,8,0"
                     Style="{StaticResource PagesFieldStyle}"
                     Text="{Binding SelectedPageName, UpdateSourceTrigger=PropertyChanged}" />
            <Button x:Name="RenamePageButton"
                    Grid.Column="1"
                    Style="{StaticResource PagesButtonStyle}"
                    Content="Rename"
                    IsEnabled="{Binding CanRenameSelected}"
                    Command="{Binding RenamePageCommand}" />
        </Grid>

        <!-- Optional per-page background (user-requested addition): a validated color and/or an
             absolute image path. Apply persists both drafts atomically; Clear removes one layer
             immediately. Both render behind the widgets on the active page. -->
        <TextBlock Text="Page background" Style="{StaticResource PagesSectionHeaderStyle}" />
        <TextBlock Text="Color (#RRGGBB or #AARRGGBB; blank = theme)"
                   FontSize="13"
                   Margin="0,0,0,2"
                   TextWrapping="Wrap" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="BackgroundColorBox"
                     Grid.Column="0"
                     Margin="0,0,8,0"
                     Style="{StaticResource PagesFieldStyle}"
                     Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanEditBackground}" />
            <Button x:Name="ApplyBackgroundButton"
                    Grid.Column="1"
                    Style="{StaticResource PagesButtonStyle}"
                    Content="Apply"
                    AutomationProperties.Name="Apply page background"
                    IsEnabled="{Binding CanEditBackground}"
                    Command="{Binding ApplyBackgroundCommand}" />
        </Grid>

        <TextBlock Text="Image (absolute path)"
                   FontSize="13"
                   Margin="0,6,0,2" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="BackgroundImageBox"
                     Grid.Column="0"
                     Margin="0,0,8,0"
                     Style="{StaticResource PagesFieldStyle}"
                     Text="{Binding BackgroundImagePath, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanEditBackground}" />
            <Button x:Name="BrowseBackgroundImageButton"
                    Grid.Column="1"
                    Style="{StaticResource PagesButtonStyle}"
                    Content="Browse"
                    AutomationProperties.Name="Browse for a page background image"
                    IsEnabled="{Binding CanEditBackground}"
                    Command="{Binding BrowseBackgroundImageCommand}" />
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Focusable="False">
            <Button x:Name="ClearBackgroundColorButton"
                    Style="{StaticResource PagesButtonStyle}"
                    Content="Clear color"
                    AutomationProperties.Name="Clear page background color"
                    IsEnabled="{Binding CanEditBackground}"
                    Command="{Binding ClearBackgroundColorCommand}" />
            <Button x:Name="ClearBackgroundImageButton"
                    Style="{StaticResource PagesButtonStyle}"
                    Content="Clear image"
                    Margin="0"
                    AutomationProperties.Name="Clear page background image"
                    IsEnabled="{Binding CanEditBackground}"
                    Command="{Binding ClearBackgroundImageCommand}" />
        </StackPanel>

        <!-- Inline, focus-free confirmation; never a modal window or a MessageBox. -->
        <Border x:Name="RemoveConfirmation"
                Margin="0,8,0,0"
                Padding="12"
                Background="{DynamicResource WidgetSurfaceBrush}"
                BorderBrush="{DynamicResource PanelAccentBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="{Binding IsRemoveConfirmationVisible, Converter={StaticResource PagesBoolToVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel Focusable="False">
                <TextBlock Text="Remove this page?"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource PanelForegroundBrush}" />
                <TextBlock Text="{Binding PendingRemovePageName}"
                           Margin="0,2,0,0"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource PanelForegroundBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Focusable="False">
                    <Button x:Name="CancelRemovePageButton"
                            Style="{StaticResource PagesButtonStyle}"
                            Content="Cancel"
                            Command="{Binding CancelRemoveCommand}" />
                    <Button x:Name="ConfirmRemovePageButton"
                            Style="{StaticResource PagesButtonStyle}"
                            Content="Remove"
                            Margin="0"
                            Command="{Binding ConfirmRemoveCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock x:Name="PagesStatusText"
                   Text="{Binding StatusMessage}"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Visibility="{Binding HasStatusMessage, Converter={StaticResource PagesBoolToVisibilityConverter}, FallbackValue=Collapsed}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource PanelForegroundBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource WidgetErrorBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
