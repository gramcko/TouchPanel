<Window x:Class="TouchPanel.Views.Setup.FirstRunSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TouchPanel Setup"
        Width="640"
        SizeToContent="Height"
        MaxHeight="760"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowActivated="True"
        Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource PanelForegroundBrush}"
        TextOptions.TextFormattingMode="Display">

    <!--
        First-run setup (deliberate user action): a normal activating window shown once, before the
        panel is placed, when panel.json did not exist. Unlike the panel it may activate; choosing a
        monitor and saving (or skipping) never changes the panel's normal no-activate behavior.
        Touch-friendly: every affordance is at least 40 DIP.
    -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TouchPanel;component/Theme/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource PanelAccentBrush}" />
                <Setter Property="Margin" Value="0,16,0,6" />
            </Style>

            <Style x:Key="BadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource PanelAccentBrush}" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource PanelBackgroundBrush}" />
            </Style>

            <Style x:Key="MonitorItemStyle" TargetType="ListBoxItem">
                <Setter Property="MinHeight" Value="56" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource WidgetSurfaceBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="24">

        <TextBlock Text="Welcome to TouchPanel"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6" />

        <TextBlock Text="Choose where the panel should appear and whether TouchPanel should start with Windows. You can change both later from the tray menu."
                   FontSize="13"
                   TextWrapping="Wrap"
                   Opacity="0.85" />

        <TextBlock Text="Monitor" Style="{StaticResource SectionHeaderStyle}" />

        <TextBlock x:Name="NoMonitorsText"
                   Text="No monitors were detected. TouchPanel will use the default monitor selection; you can still choose the start-with-Windows option below."
                   FontSize="13"
                   TextWrapping="Wrap"
                   Opacity="0.85"
                   Margin="0,0,0,6">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasMonitors}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ListBox x:Name="MonitorList"
                 ItemsSource="{Binding Monitors}"
                 SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource MonitorItemStyle}"
                 Background="Transparent"
                 BorderThickness="0"
                 MaxHeight="320"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource WidgetSurfaceBrush}"
                            BorderBrush="{DynamicResource WidgetBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Border Style="{StaticResource BadgeStyle}"
                                        Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Primary" Style="{StaticResource BadgeTextStyle}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding IdentitySummary}"
                                       FontSize="12"
                                       Opacity="0.8"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="Startup" Style="{StaticResource SectionHeaderStyle}" />

        <CheckBox x:Name="StartWithWindowsCheckBox"
                  MinHeight="40"
                  FontSize="14"
                  Content="Start TouchPanel with Windows"
                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button x:Name="SkipButton"
                    Content="Skip"
                    MinHeight="44"
                    MinWidth="120"
                    Padding="20,8"
                    Margin="0,0,12,0"
                    Click="OnSkipClick" />
            <Button x:Name="SaveButton"
                    Content="Save and continue"
                    MinHeight="44"
                    MinWidth="160"
                    Padding="20,8"
                    IsDefault="True"
                    Click="OnSaveClick" />
        </StackPanel>
    </StackPanel>
</Window>
